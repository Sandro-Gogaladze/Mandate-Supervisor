# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example

# Ad hoc case submissions (runtime data, not the curated corpus)
data/uploads/

# Runtime case ledger (append-only record; regenerated by seeding + runs)
data/ledger.db

# Policy-sandbox working state: drafts are candidates, sweeps are experiments.
# Neither is policy, and neither should arrive in a checkout as if it were.
registry/drafts/
data/sandbox.db

# One-off ledger snapshots taken before a reseed or rebuild — backups,
# previous copies, JSONL exports. Large (247 MB and counting), local, and not
# the record: the ledger of consequence is data/ledger.db, rebuilt by seeding.
data/ledger-*.db
data/ledger-*.jsonl

# Offline image bundles produced by `make save`
mandate-supervisor-*.tar.gz

# ── Local tooling ────────────────────────────────────────────────────────────
# Vendored agent skills and critique output. Development aids, not the product.
.agents/
.claude/skills/
.impeccable/
.pytest_cache/
skills-lock.json

# ── Working documents ────────────────────────────────────────────────────────
# The repo ships six markdown files on purpose:
#   README.md, CLAUDE.md, and docs/{supervision-model,architecture,guardrails,
#   development}.md, plus the frozen docs/concept-note.md.
# Everything below is build-time scaffolding — the running plan, per-phase
# specs, superseded architecture drafts, explainers whose numbers have drifted,
# and pitch drafts. Kept on disk, kept out of the repo, because a reader cannot
# tell which of fifty documents is the one that is still true.
