# Copy to .env and fill in. Only the first line matters to get started.

# Your own key, from https://console.anthropic.com -> API keys.
# Leave it empty and the console still runs: every deterministic check
# (signature verification, structuring detection, scoring) works without a
# key — only the LLM judgement layer is skipped, with a clear message.
ANTHROPIC_API_KEY=

# ---- optional ----------------------------------------------------------

# Which published release to run. Pin this to a version for a stable demo;
# `latest` moves under you.
# TAG=latest

# Host port for the console.
# PORT=5173

# Reasoning budget per specialist judgement: low | medium | high.
# Higher is slower — "high" took a full review to roughly ten minutes.
# MANDATE_THINKING_EFFORT=low

# Concurrent model calls across the graph.
# MANDATE_MODEL_CONCURRENCY=8

# Lock intake to known institutions: {"token":"institution_id"}.
# Unset means any dossier may be submitted, which is fine locally and
# is NOT fine on a public URL.
# MANDATE_INSTITUTION_TOKENS=
